// --- Funnel ---
const funnelEl = document.getElementById('funnel');
DATA.funnel.forEach((f, i) => {
  const prev = i > 0 ? DATA.funnel[i-1].count : f.count;
  const drop = i > 0 ? prev - f.count : 0;
  const dropPct = i > 0 ? Math.round(100 * drop / prev) : 0;
  const stepPct = i > 0 ? Math.round(100 * f.count / prev) : 100;
  const barW = f.pct;
  const dropHtml = i > 0
    ? `<span class="drop-negative">−${dropPct}%</span>`
    : `<span style="color:var(--muted)">—</span>`;
  const stepHtml = i > 0
    ? `<span style="color:var(--accent);font-weight:700">${stepPct}%</span>`
    : `<span style="color:var(--muted)">старт</span>`;
  funnelEl.innerHTML += `
    <div class="funnel-row">
      <div class="funnel-label">${f.label}</div>
      <div class="funnel-bar-wrap">
        <div class="funnel-bar s${i}" style="width:${barW}%">${f.pct}%</div>
      </div>
      <div class="funnel-pct" style="color:${i===0?'var(--text)':i===3?'var(--success)':i===4?'var(--warn)':'var(--text)'}">${f.pct}%</div>
      <div class="funnel-count">${f.count}</div>
      <div class="funnel-step-pct">${stepHtml}</div>
      <div class="funnel-drop">${dropHtml}</div>
    </div>`;
});


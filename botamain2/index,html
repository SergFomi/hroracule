<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Botamin — Дашборд аналитика</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root {
    --bg: #0f1117;
    --surface: #1a1d27;
    --surface2: #222535;
    --border: #2a2d3e;
    --text: #e2e8f0;
    --muted: #8892a4;
    --accent: #6c63ff;
    --accent2: #00c9a7;
    --warn: #f59e0b;
    --danger: #ef4444;
    --success: #22c55e;
    --blue: #3b82f6;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, 'Segoe UI', sans-serif; font-size: 18px; min-height: 100vh; }

  header { padding: 20px 28px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
  header h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.3px; }
  header h1 span { color: var(--accent); }
  .meta { color: var(--muted); font-size: 15px; text-align: right; line-height: 1.6; }

  .main { padding: 20px 28px; display: flex; flex-direction: column; gap: 20px; }

  /* KPI Cards */
  .kpi-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; position: relative; overflow: hidden; }
  .kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--accent); }
  .kpi.green::before { background: var(--success); }
  .kpi.blue::before { background: var(--blue); }
  .kpi.yellow::before { background: var(--warn); }
  .kpi.red::before { background: var(--danger); }
  .kpi-label { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
  .kpi-value { font-size: 48px; font-weight: 800; line-height: 1; letter-spacing: -1px; }
  .kpi-sub { font-size: 14px; color: var(--muted); margin-top: 4px; }

  /* Grid layouts */
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid3 { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; }

  /* Card */
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px; }
  .card-title { font-size: 16px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .card-title .badge { font-size: 10px; padding: 2px 7px; border-radius: 20px; font-weight: 600; text-transform: none; letter-spacing: 0; }
  .badge-critical { background: rgba(239,68,68,.15); color: var(--danger); }
  .badge-opportunity { background: rgba(34,197,94,.15); color: var(--success); }
  .badge-insight { background: rgba(59,130,246,.15); color: var(--blue); }
  .badge-bug { background: rgba(245,158,11,.15); color: var(--warn); }

  /* Funnel */
  .funnel { display: flex; flex-direction: column; gap: 8px; }
  .funnel-row { display: flex; align-items: center; gap: 10px; }
  .funnel-label { width: 240px; font-size: 15px; color: var(--text); flex-shrink: 0; }
  .funnel-bar-wrap { flex: 1; height: 32px; background: var(--surface2); border-radius: 5px; overflow: hidden; position: relative; }
  .funnel-bar { height: 100%; border-radius: 5px; display: flex; align-items: center; padding-left: 10px; font-size: 14px; font-weight: 700; color: #fff; transition: width 0.8s ease; }
  .funnel-pct { width: 56px; text-align: right; font-size: 16px; font-weight: 700; flex-shrink: 0; }
  .funnel-count { width: 48px; text-align: right; font-size: 14px; color: var(--muted); flex-shrink: 0; }
  .funnel-drop { width: 70px; text-align: right; font-size: 14px; flex-shrink: 0; }
  .drop-negative { color: var(--danger); }
  .funnel-bar.s0 { background: linear-gradient(90deg, #6c63ff, #8b5cf6); }
  .funnel-bar.s1 { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
  .funnel-bar.s2 { background: linear-gradient(90deg, #06b6d4, #22d3ee); }
  .funnel-bar.s3 { background: linear-gradient(90deg, #10b981, #34d399); }
  .funnel-bar.s4 { background: linear-gradient(90deg, #22c55e, #86efac); }
  .funnel-header { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .funnel-header-label { width: 190px; font-size: 10px; color: var(--muted); flex-shrink: 0; }
  .funnel-header-bar { flex: 1; font-size: 10px; color: var(--muted); }
  .funnel-header-pct { width: 46px; text-align: right; font-size: 10px; color: var(--muted); flex-shrink: 0; }
  .funnel-header-count { width: 38px; text-align: right; font-size: 10px; color: var(--muted); flex-shrink: 0; }
  .funnel-header-drop { width: 70px; text-align: right; font-size: 10px; color: var(--muted); flex-shrink: 0; }
  .funnel-step-pct { width: 56px; text-align: right; font-size: 11px; color: var(--muted); flex-shrink: 0; }

  /* Patterns */
  .patterns { display: flex; flex-direction: column; gap: 10px; }
  .pattern-item { background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
  .pattern-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; }
  .pattern-desc { font-size: 15px; color: var(--muted); line-height: 1.5; }

  /* Dropout quotes */
  .dropout-tabs { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
  .tab-btn { padding: 5px 12px; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 11px; cursor: pointer; transition: all 0.15s; }
  .tab-btn.active { background: var(--accent); border-color: var(--accent); color: white; font-weight: 600; }
  .tab-btn:hover:not(.active) { border-color: var(--accent); color: var(--text); }
  .quotes-list { display: flex; flex-direction: column; gap: 8px; }
  .quote-item { background: var(--surface2); border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; padding: 9px 12px; font-size: 12px; color: var(--text); line-height: 1.5; font-style: italic; }

  /* Charts */
  .chart-wrap { position: relative; }

  /* Reason donut */
  .reason-legend { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .reason-row { display: flex; align-items: center; gap: 8px; }
  .reason-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }
  .reason-name { font-size: 12px; flex: 1; }
  .reason-val { font-size: 12px; font-weight: 600; }
  .reason-pct { font-size: 11px; color: var(--muted); width: 36px; text-align: right; }

  /* Industry table */
  .ind-table { width: 100%; border-collapse: collapse; }
  .ind-table th { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; padding: 6px 8px; text-align: left; border-bottom: 1px solid var(--border); }
  .ind-table td { padding: 8px 8px; font-size: 12px; border-bottom: 1px solid var(--border); }
  .ind-table tr:last-child td { border-bottom: none; }
  .ind-table tr:hover td { background: var(--surface2); }
  .rate-bar-wrap { width: 80px; height: 6px; background: var(--surface2); border-radius: 3px; overflow: hidden; display: inline-block; margin-right: 6px; vertical-align: middle; }
  .rate-bar { height: 100%; border-radius: 3px; }
  .rate-good { background: var(--success); }
  .rate-mid { background: var(--warn); }
  .rate-bad { background: var(--danger); }
  .rate-num { vertical-align: middle; font-weight: 600; }

  /* Hour bars */
  .hour-bars { display: flex; flex-direction: column; gap: 5px; }
  .hour-row { display: flex; align-items: center; gap: 8px; }
  .hour-label { width: 36px; font-size: 11px; color: var(--muted); flex-shrink: 0; text-align: right; }
  .hour-track { flex: 1; height: 22px; background: var(--surface2); border-radius: 4px; overflow: hidden; position: relative; }
  .hour-fill-total { height: 100%; background: var(--surface2); position: absolute; left: 0; top: 0; }
  .hour-fill-meeting { height: 100%; background: var(--accent); position: absolute; left: 0; top: 0; opacity: 0.85; border-radius: 4px; }
  .hour-fill-rest { height: 100%; background: var(--border); position: absolute; left: 0; top: 0; border-radius: 4px; }
  .hour-text { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-size: 10px; color: var(--muted); }
  .hour-rate { width: 38px; font-size: 11px; font-weight: 600; text-align: right; flex-shrink: 0; }
  .hour-cnt { width: 32px; font-size: 10px; color: var(--muted); text-align: right; flex-shrink: 0; }

  canvas { max-width: 100%; }

  .section-title { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.8px; padding: 4px 0 12px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }

  .ab-box { background: linear-gradient(135deg, rgba(108,99,255,0.08), rgba(0,201,167,0.08)); border: 1px solid rgba(108,99,255,0.3); border-radius: 10px; padding: 18px; }
  .ab-title { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
  .ab-sub { font-size: 15px; color: var(--muted); margin-bottom: 14px; }
  .ab-variants { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ab-var { background: var(--surface2); border-radius: 8px; padding: 14px; }
  .ab-var-label { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
  .ab-var-text { font-size: 16px; font-weight: 600; line-height: 1.4; margin-bottom: 8px; }
  .ab-var-note { font-size: 14px; color: var(--muted); }
  .ab-hypothesis { font-size: 15px; color: var(--accent2); margin-top: 12px; }

  /* Global level */
  .global-bar { background: var(--surface2); border-bottom: 1px solid var(--border); padding: 14px 28px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .global-label { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-right: -12px; }
  .global-stat { display: flex; flex-direction: column; align-items: center; gap: 1px; }
  .global-stat .val { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
  .global-stat .lbl { font-size: 13px; color: var(--muted); }
  .global-divider { width: 1px; height: 36px; background: var(--border); }
  .funnel-global { display: flex; align-items: center; gap: 0; flex: 1; min-width: 300px; }
  .fg-step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; }
  .fg-step::after { content: '→'; position: absolute; right: -8px; top: 50%; transform: translateY(-50%); color: var(--border); font-size: 16px; z-index:1; }
  .fg-step:last-child::after { display: none; }
  .fg-val { font-size: 18px; font-weight: 700; }
  .fg-lbl { font-size: 12px; color: var(--muted); text-align: center; }
  .fg-pct { font-size: 13px; color: var(--success); font-weight: 600; }

  .section-sep { margin: 4px 0 12px; }
  .section-sep span { font-size: 18px; color: var(--muted); font-weight: 600; }

  /* Comparison */
  .kpi-compare { font-size: 14px; color: var(--muted); margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 5px; }
  .kpi-compare .no-data { color: var(--border); font-style: italic; }
  .compare-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .compare-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .compare-card-title { font-size: 13px; color: var(--muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
  .compare-metric { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 5px 0; border-bottom: 1px solid var(--border); }
  .compare-metric:last-child { border-bottom: none; }
  .compare-metric-label { font-size: 14px; color: var(--muted); }
  .compare-metric-vals { display: flex; align-items: baseline; gap: 8px; }
  .compare-current { font-size: 16px; font-weight: 700; }
  .compare-prev { font-size: 14px; color: var(--border); font-style: italic; }
</style>
</head>
<body>

<header>
  <div>
    <h1><span>Botamin</span> — Дашборд аналитика</h1>
    <div style="font-size:12px;color:var(--muted);margin-top:3px;">ИИ-продавец «Лариса» · 25–29 мая 2026 · Оптовая торговля + др.</div>
  </div>
  <div class="meta">
    Бот: Лариса (батамИн)<br>
    <span style="color:var(--accent)">2 уровня анализа: вся неделя + глубокие диалоги</span>
  </div>
</header>

<!-- GLOBAL STATS BAR -->
<div class="global-bar">
  <div class="global-label">Вся неделя →</div>
  <div class="global-stat"><div class="val">11 486</div><div class="lbl">всего звонков</div></div>
  <div class="global-divider"></div>
  <div class="funnel-global">
    <div class="fg-step">
      <div class="fg-val" style="color:var(--blue)">1 304</div>
      <div class="fg-lbl">реальных диалогов</div>
      <div class="fg-pct">11.4%</div>
    </div>
    <div class="fg-step">
      <div class="fg-val" style="color:var(--accent2)">133</div>
      <div class="fg-lbl">попытки встречи</div>
      <div class="fg-pct">10.2% от диалогов</div>
    </div>
    <div class="fg-step">
      <div class="fg-val" style="color:var(--success)">23</div>
      <div class="fg-lbl">встреч назначено</div>
      <div class="fg-pct">17% из попыток</div>
    </div>
  </div>

</div>

<div class="main">
  <div class="section-sep"><span>Детальный анализ диалогов · 1 304 реальных разговора из 11 486 звонков · человек сказал что-то осмысленное, Алиса и автоответчики исключены</span></div>

  <!-- KPI — 3 главных -->
  <div class="kpi-row" style="grid-template-columns: repeat(3, 1fr)">
    <div class="kpi green">
      <div class="kpi-label">Встреча назначена</div>
      <div class="kpi-value" style="color:var(--success)">23</div>
      <div class="kpi-sub">1.8% от реальных диалогов</div>
      <div class="kpi-compare">пред. период: <span class="no-data">нет данных</span></div>
    </div>
    <div class="kpi yellow">
      <div class="kpi-label">Квалифицированы</div>
      <div class="kpi-value" style="color:var(--warn)">7</div>
      <div class="kpi-sub">0.5% · горячие лиды</div>
      <div class="kpi-compare">пред. период: <span class="no-data">нет данных</span></div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Реальных диалогов</div>
      <div class="kpi-value">1 304</div>
      <div class="kpi-sub">из 11 486 звонков (11.4%)</div>
      <div class="kpi-compare">пред. период: <span class="no-data">нет данных</span></div>
    </div>
  </div>
  <!-- Funnel -->
  <div class="card">
    <div class="card-title">Воронка успешных диалогов</div>
    <div class="funnel-header">
      <div class="funnel-header-label">Этап</div>
      <div class="funnel-header-bar"></div>
      <div class="funnel-header-pct">от старта</div>
      <div class="funnel-header-count">кол-во</div>
      <div class="funnel-header-drop" style="width:56px">от пред. шага</div>
      <div class="funnel-header-drop">отвал</div>
    </div>
    <div class="funnel" id="funnel"></div>
    <div style="margin-top:12px;font-size:14px;color:var(--muted);display:flex;gap:16px">
      <span><b style="color:var(--text)">от старта</b> — доля от 1 304 реальных диалогов</span>
      <span><b style="color:var(--accent)">от пред. шага</b> — конверсия между этапами</span>
    </div>
  </div>


  <!-- Patterns / Insights -->
  <div class="card">
    <div class="card-title">Паттерны и точки роста</div>
    <div class="patterns" id="patterns"></div>
  </div>

  <!-- A/B Test Suggestion -->
  <div class="ab-box">
    <div class="ab-title">🧪 A/B тест #1 — приветственная фраза (наибольший потенциал)</div>
    <div class="ab-sub">Из 1 304 реальных диалогов 256 (19.6%) завершились до того, как бот успел озвучить оффер. «Искусственный интеллект» в первой фразе — вероятный триггер. Тест фокусируется на замене «ИИ-фрейма» на «результат-фрейм».</div>
    <div class="ab-variants">
      <div class="ab-var" style="background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.25)">
        <div class="ab-var-label">⚙️ Контроль (текущий)</div>
        <div class="ab-var-text">«Иван Иваныч, добрый день! Звоню насчёт искусственного интеллекта в вашем отделе продаж — у нас есть кейс по [Отрасли], хотела показать. Тридцать секунд займет, ладно?»</div>
        <div class="ab-var-note">⚠ «Искусственный интеллект» в первой фразе → триггер отбоя, особенно у аудитории 45+</div>
      </div>
      <div class="ab-var" style="background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.25)">
        <div class="ab-var-label">✨ Вариант B (предложение аналитика)</div>
        <div class="ab-var-text">«Иван Иваныч, добрый день! Звоню насчёт роста продаж в вашей отрасли — есть конкретная механика, интересно?»</div>
        <div class="ab-var-note">✓ Фокус на результате («рост продаж»), не на инструменте. «ИИ» и «робот» — вообще не упоминается. Вопрос в конце открытый, не «ладно?»</div>
      </div>
    </div>
    <div style="display:flex;gap:12px;margin-top:12px;flex-wrap:wrap">
      <div style="flex:1;min-width:200px;background:var(--surface2);border-radius:8px;padding:12px 14px">
        <div style="font-size:13px;color:var(--muted);margin-bottom:6px">МЕТРИКА ТЕСТА</div>
        <div style="font-size:15px">Конверсия этапа 0→1 (согласие на разговор)</div>
        <div style="font-size:14px;color:var(--muted);margin-top:4px">Текущий baseline: <b style="color:var(--text)">60.3%</b></div>
      </div>
      <div style="flex:1;min-width:200px;background:var(--surface2);border-radius:8px;padding:12px 14px">
        <div style="font-size:13px;color:var(--muted);margin-bottom:6px">ОБЪЁМ ТЕСТА</div>
        <div style="font-size:15px">~500 звонков на вариант (≈2 дня звонков)</div>
        <div style="font-size:14px;color:var(--muted);margin-top:4px">Достаточно для 95% значимости при &Delta;5%+</div>
      </div>
      <div style="flex:1;min-width:200px;background:var(--surface2);border-radius:8px;padding:12px 14px">
        <div style="font-size:13px;color:var(--muted);margin-bottom:6px">ОЖИДАЕМЫЙ ЭФФЕКТ</div>
        <div style="font-size:15px">+8–15% к конверсии 0→1</div>
        <div style="font-size:14px;color:var(--muted);margin-top:4px">= <b style="color:var(--success)">+10–20 встреч</b> в неделю без изменения базы</div>
      </div>
    </div>
  </div>

  <!-- Period comparison — bottom -->
  <div class="card">
    <div class="card-title">Сравнение с предыдущим периодом</div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:15px">
        <thead>
          <tr>
            <th style="text-align:left;padding:10px 10px;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);font-weight:600">Метрика</th>
            <th style="text-align:right;padding:10px 10px;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);font-weight:600">Тек. период<br><span style="font-weight:400;text-transform:none;font-size:12px">25–29 мая 2026</span></th>
            <th style="text-align:right;padding:10px 10px;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);font-weight:600">Пред. период</th>
            <th style="text-align:right;padding:10px 10px;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);font-weight:600">Изменение</th>
          </tr>
        </thead>
        <tbody id="compareTable"></tbody>
      </table>
    </div>
    <div style="margin-top:10px;font-size:14px;color:var(--muted);padding:10px 14px;background:var(--surface2);border-radius:6px">
      💡 Для следующего отчёта достаточно передать CSV-выгрузку за прошлую неделю — таблица заполнится автоматически.
    </div>
  </div>

</div><!-- /main -->

<script>
// Compare table
const compareMetrics = [
